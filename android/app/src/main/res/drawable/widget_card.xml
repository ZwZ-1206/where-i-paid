<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件的卡片底。固定浅色，不跟着深色模式翻：
  RemoteViews 在系统深浅色翻转时不一定会被重画（没人发 APPWIDGET_UPDATE），
  颜色跟着 Resources 走就会出现「系统上翻到深色了、卡片还是旧的浅色」这类半吊子状态。
  固定浅色卡片在深浅壁纸上都成立，代价远小于这个不确定性。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_line" />
</shape>
