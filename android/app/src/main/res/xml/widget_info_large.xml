<?xml version="1.0" encoding="utf-8"?>
<!--
  大号档：4×3（250×180dp，公式 70n − 30）。

  和「标准档」是同一套布局，区别只在**起始尺寸**更大，所以一放上去就能直接看到
  周期与预算进度（那个段落需要 h≥150，标准档 110dp 放不下）。
  拉到 4×4 以上还会再多出近 7 天柱图和最近三笔。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="460dp"
    android:maxResizeHeight="320dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_bill"
    android:description="@string/widget_desc_large"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
